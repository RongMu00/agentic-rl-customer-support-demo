{
  "scenario_id": "refund-retry-002",
  "title": "Recovery from a transient tool failure",
  "description": "The first order lookup times out. The runtime retries the read without duplicating the eventual refund side effect.",
  "customer_message": "Order ORD-2099 arrived damaged yesterday. Please refund it.",
  "environment": {
    "order": {
      "order_id": "ORD-2099",
      "customer_id": "CUS-47",
      "market": "US",
      "status": "delivered",
      "amount": 74.5,
      "currency": "USD",
      "damaged": true,
      "days_since_delivery": 1
    },
    "policy": {
      "market": "US",
      "topic": "damaged_item_refund",
      "refund_window_days": 30,
      "requires_damage_evidence": false
    }
  },
  "allowed_write_tools": ["refunds.issue", "customer.reply"],
  "required_read_tools": ["orders.get", "policy.search", "refunds.simulate"],
  "required_side_effects": ["refunds.issue", "customer.reply"],
  "failure_injections": {"orders.get": 1},
  "max_retries": 2,
  "plan": [
    {"tool": "orders.get", "arguments": {"order_id": "ORD-2099"}},
    {"tool": "policy.search", "arguments": {"market": "US", "topic": "damaged_item_refund"}},
    {"tool": "refunds.simulate", "arguments": {"order_id": "ORD-2099", "amount": 74.5}},
    {"tool": "refunds.issue", "arguments": {"order_id": "ORD-2099", "amount": 74.5}},
    {"tool": "customer.reply", "arguments": {"message": "I'm sorry about the damage. I issued the $74.50 refund for ORD-2099."}}
  ],
  "final_message": "I'm sorry about the damage. I issued the $74.50 refund for ORD-2099."
}
